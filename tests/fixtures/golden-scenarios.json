[
  {
    "name": "workspace-inspection",
    "prompt": "inspect the workspace and read notes.md",
    "files": {
      "notes.md": "seed\n"
    },
    "turns": [
      {
        "toolCalls": [
          { "callId": "g-list", "name": "list_files", "arguments": { "path": ".", "maxDepth": 1 } },
          { "callId": "g-workspace", "name": "workspace_info", "arguments": {} },
          { "callId": "g-read", "name": "read_file", "arguments": { "path": "notes.md" } }
        ]
      },
      {
        "final": "inspection complete"
      }
    ],
    "expect": {
      "toolSequence": ["list_files", "workspace_info", "read_file"],
      "finalText": "inspection complete"
    }
  },
  {
    "name": "planned-edit",
    "prompt": "update note.txt following a plan",
    "files": {
      "note.txt": "hello\n"
    },
    "turns": [
      {
        "toolCalls": [
          {
            "callId": "g-plan",
            "name": "update_plan",
            "arguments": {
              "steps": [
                { "content": "Read note.txt", "status": "completed" },
                { "content": "Update note.txt", "status": "in_progress" }
              ]
            }
          }
        ]
      },
      {
        "toolCalls": [
          { "callId": "g-read-note", "name": "read_file", "arguments": { "path": "note.txt" } }
        ]
      },
      {
        "toolCalls": [
          {
            "callId": "g-patch",
            "name": "apply_patch",
            "arguments": {
              "patch": "diff --git a/note.txt b/note.txt\n--- a/note.txt\n+++ b/note.txt\n@@ -1,1 +1,1 @@\n-hello\n+hello world\n"
            }
          }
        ]
      },
      {
        "final": "edited"
      }
    ],
    "expect": {
      "toolSequence": ["update_plan", "read_file", "apply_patch"],
      "finalText": "edited",
      "fileAfter": { "note.txt": "hello world\n" }
    }
  }
]